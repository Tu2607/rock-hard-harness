#!/usr/bin/env bash
# Run rockhard inside the scanner container against this host.
#
#   sudo bin/rockhard-container build
#   sudo bin/rockhard-container detect
#   sudo bin/rockhard-container feeds fetch
#   sudo bin/rockhard-container scan compliance --remediate
#   sudo bin/rockhard-container scan cve
#
# Isolation: the host root is mounted read-only at /host, all capabilities are
# dropped except DAC_READ_SEARCH (to read root-only files such as
# /etc/shadow) and SYS_CHROOT (oscap's probes chroot into /host when
# OSCAP_PROBE_ROOT is set, and abort without it), and scans run with networking disabled. Only `feeds fetch`
# gets network access, and it can only write to the feed cache volume.
# Results land in $ROCKHARD_OUT (default ./rockhard-out) on the host.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="${ROCKHARD_IMAGE:-localhost/rock-hard-harness:latest}"
OUT="${ROCKHARD_OUT:-$PWD/rockhard-out}"
FEEDS_VOLUME="${ROCKHARD_FEEDS_VOLUME:-rockhard-feeds}"

if [[ -n "${ROCKHARD_ENGINE:-}" ]]; then
  engine="$ROCKHARD_ENGINE"
elif command -v podman >/dev/null; then
  engine=podman
elif command -v docker >/dev/null; then
  engine=docker
else
  echo "rockhard-container: need podman or docker" >&2
  exit 1
fi

if [[ "${1:-}" == "build" ]]; then
  shift
  exec "$engine" build -t "$IMAGE" -f "$here/container/Containerfile" "$@" "$here"
fi

if [[ $EUID -ne 0 ]]; then
  echo "rockhard-container: run as root; rootless containers cannot read root-owned host files" >&2
  exit 1
fi

mkdir -p "$OUT"

# The host root must be read-only all the way down, submounts (/boot, /proc,
# /sys, ...) included. A plain `ro` bind only covers the top mount: the
# submounts come along through rbind and stay writable.
#
# Docker cannot do that for /: a recursive read-only bind needs rprivate
# propagation, and Docker refuses rprivate for a source that contains its own
# data root (/var/lib/docker). Docker therefore takes the per-mount path below.
if [[ "$engine" == docker ]]; then
  rro=no
elif "$engine" run --rm --network none -v "$OUT:/probe:rro" --entrypoint true "$IMAGE" >/dev/null 2>&1; then
  rro=yes
else
  rro=no
fi

if [[ $rro == yes ]]; then
  host_mount=(-v "/:/host:rro")
else
  # No recursive read-only binds (Docker, podman < 4, old crun, kernel < 5.12): lay a
  # read-only bind over every host mount point, so each submount the rbind
  # brought in is covered by a read-only copy of itself. Known gap: the engine's
  # own storage (/var/lib/containers/storage/overlay for podman, /var/lib/docker
  # for Docker) stays writable, because the engine mounts this
  # container's rootfs there after the binds are laid out.
  echo "rockhard-container: no recursive read-only bind with $engine; binding each host mount read-only (the engine's own storage stays writable)" >&2
  host_mount=()
  while IFS= read -r target; do
    if [[ "$target" == *[\\:,]* ]]; then
      echo "rockhard-container: cannot bind $target read-only (special characters); refusing to scan with a writable submount" >&2
      exit 1
    fi
    host_mount+=(-v "$target:/host${target%/}:ro")
  done < <(findmnt -rn -o TARGET | awk '!seen[$0]++')
fi

# oscap reads the rpm database from /usr/lib/sysimage/rpm whenever that
# directory exists, but EL8/EL9 keep it in /var/lib/rpm and some of them also
# carry a stale copy in /usr/lib/sysimage/rpm (Oracle Linux 9). Show oscap the
# real one there. Read-only, and only inside the container.
if [[ -d /usr/lib/sysimage/rpm && ! -L /usr/lib/sysimage/rpm && -d /var/lib/rpm && ! -L /var/lib/rpm ]] \
   && grep -qE '^%_dbpath[[:space:]]+%\{_var\}/lib/rpm' /usr/lib/rpm/macros 2>/dev/null \
   && [[ "$(readlink -f /usr/lib/sysimage/rpm)" != "$(readlink -f /var/lib/rpm)" ]]; then
  host_mount+=(-v "/var/lib/rpm:/host/usr/lib/sysimage/rpm:ro")
fi

args=(
  run --rm
  "${host_mount[@]}"
  -v "$OUT:/out"
  -v "$FEEDS_VOLUME:/var/cache/rockhard/feeds"
  --cap-drop ALL --cap-add DAC_READ_SEARCH --cap-add SYS_CHROOT
  --security-opt no-new-privileges
  --security-opt label=disable
  --read-only --tmpfs /tmp
)

# Only feed downloads need the network.
if [[ "${1:-} ${2:-}" != "feeds fetch" ]]; then
  args+=(--network none)
fi

exec "$engine" "${args[@]}" "$IMAGE" "$@"
